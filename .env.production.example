DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=oaknamu.com,www.oaknamu.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://oaknamu.com,https://www.oaknamu.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HTTPS_READY=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True
DJANGO_TRUST_PROXY_HEADERS=True
DJANGO_TRUSTED_PROXY_IPS=172.30.0.0/24
DJANGO_TRUSTED_PROXY_HOPS=1

POSTGRES_DB=ax_evaluation
POSTGRES_USER=ax_evaluation
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=mail.oaknamu.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=no-reply@oaknamu.com
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=AX Console <no-reply@oaknamu.com>
DJANGO_ACCOUNT_EMAIL_SUBJECT_PREFIX="[AX Console] "

GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_ENABLED=False
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
SOCIALACCOUNT_REQUESTS_TIMEOUT=5
