DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 메일 본문 링크의 기준 주소. 비우면 DJANGO_CSRF_TRUSTED_ORIGINS의 첫 항목을 쓴다.
DJANGO_SITE_URL=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HTTPS_READY=False
DJANGO_HSTS_SECONDS=0
# 프로필 사진 등 업로드 파일 저장 경로. 비우면 프로젝트 폴더의 media/를 쓴다.
# 운영 환경에서는 배포마다 지워지지 않는 영구 볼륨 경로를 지정한다.
DJANGO_MEDIA_ROOT=

POSTGRES_DB=ax_evaluation
POSTGRES_USER=ax_evaluation
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_ENABLED=False
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
SOCIALACCOUNT_REQUESTS_TIMEOUT=5

DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_TRUSTED_PROXY_HOPS=0
